{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.acme-retail.test/orderflow/schemas/order-created.v1.schema.json",
  "title": "order.created.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "correlationId", "causationId", "aggregateId", "producer", "data"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "const": "order.created.v1" },
    "eventVersion": { "const": "1" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": "string", "minLength": 1 },
    "aggregateId": { "type": "string", "pattern": "^ord_[A-Za-z0-9]+$" },
    "producer": { "const": "CMP-ORDER-API" },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "required": ["orderId", "status", "items", "createdAt"],
      "properties": {
        "orderId": { "type": "string" },
        "status": { "const": "RECEIVED" },
        "createdAt": { "type": "string", "format": "date-time" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["productId", "quantity", "productSnapshot"],
            "properties": {
              "productId": { "type": "string" },
              "quantity": { "type": "integer", "minimum": 1 },
              "productSnapshot": {
                "type": "object",
                "additionalProperties": true,
                "required": ["name", "category"],
                "properties": {
                  "name": { "type": "string" },
                  "category": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}

